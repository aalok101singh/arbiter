# Razorpay API Keys (Get these from your Razorpay Dashboard in Test Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_SECRET

# Arbiter Guard Modes (Options: "shadow" or "enforce")
ARBITER_MODE=enforce

# Demo Limits (Set these low to test the guard, high for production)
ARBITER_VELOCITY_LIMIT=2
ARBITER_PAYEE_CAP=200000
ARBITER_NEW_PAYEE_THRESHOLD=50000
